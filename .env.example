# Mot de passe PostgreSQL (docker compose).
POSTGRES_PASSWORD=

# Secret partagé avec GitHub (Settings de l'app → Webhook secret).
# 32 caractères aléatoires minimum : openssl rand -hex 32
PR_SENTINEL_WEBHOOK_SECRET=

# GitHub App : identifiant. La clé privée va dans secrets/github-app.pem.
PR_SENTINEL_GITHUB_APP_ID=

# Règles Semgrep (ruleset du registre ou chemin local).
PR_SENTINEL_SEMGREP_CONFIG=p/default

# Facultatif
# PR_SENTINEL_SCANNER_TIMEOUT_SECONDS=300
# PR_SENTINEL_MAX_ATTEMPTS=5
# PR_SENTINEL_LEASE_SECONDS=1800
