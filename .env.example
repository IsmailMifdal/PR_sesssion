# Mot de passe PostgreSQL (docker compose).
POSTGRES_PASSWORD=

# Secret partagé avec GitHub (réglages de l'app → Webhook secret). 32 caractères aléatoires minimum :
#   openssl rand -hex 32
SENTINEL_WEBHOOK_SECRET=

# GitHub App : identifiant et clé privée (contenu du fichier .pem).
SENTINEL_GITHUB_APP_ID=
SENTINEL_GITHUB_PRIVATE_KEY=

# Agent IA (sans clé : alertes brutes, comme en semaine 1).
OPENAI_API_KEY=
SENTINEL_DAILY_BUDGET_USD=1.00

# Tableau de bord : jeton de 32 caractères minimum (sinon l'API /api est désactivée) et origine du front.
SENTINEL_DASHBOARD_TOKEN=
SENTINEL_DASHBOARD_ALLOWED_ORIGINS=https://pr-sentinel.vercel.app

# Connexion des utilisateurs par GitHub (onglet « General » de la GitHub App : Client ID, Client secret).
# URL de rappel à déclarer dans l'app : <SENTINEL_PUBLIC_URL>/auth/github/callback. Vide = désactivée.
SENTINEL_GITHUB_CLIENT_ID=
# Nom court de l'app (github.com/apps/<slug>) : bouton « Installer » du parcours de démarrage.
SENTINEL_GITHUB_APP_SLUG=
SENTINEL_GITHUB_CLIENT_SECRET=
SENTINEL_PUBLIC_URL=https://pr-sentinel-api.up.railway.app
SENTINEL_FRONT_URL=https://pr-sentinel.vercel.app

# Facturation Stripe (rôle API). Vide = désactivée (instance auto-hébergée : aucune limite).
# Webhook Stripe à créer vers <SENTINEL_PUBLIC_URL>/stripe/webhook, événements : checkout.session.completed,
# customer.subscription.created / updated / deleted / paused / resumed.
SENTINEL_STRIPE_SECRET_KEY=
SENTINEL_STRIPE_WEBHOOK_SECRET=
SENTINEL_STRIPE_PRICE_EQUIPE=
# Quota de l'offre Découverte (rôle worker) : revues par mois et par installation.
SENTINEL_BILLING_QUOTAS=false
SENTINEL_FREE_REVIEWS_PER_MONTH=50

# Durée de conservation des revues en jours (0 = illimitée). Purge chaque nuit à 03:17 UTC.
SENTINEL_RETENTION_DAYS=365
